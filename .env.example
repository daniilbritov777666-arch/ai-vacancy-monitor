TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
TELEGRAM_CHAT_ID=150761046

# Источники. При активном Freelancehunt API его RSS автоматически исключается.
TELEGRAM_CHANNELS=
RSS_FEEDS=https://www.fl.ru/rss/projects.xml,https://freelancehunt.com/projects.rss
PUBLIC_PROJECT_SOURCES=freelance_ru,pchel,weblancer
PUBLIC_SOURCE_PROBES=kwork,workzilla

# Локальный режим агента.
LOCAL_AGENT_LOOP=true
LOCAL_AGENT_INTERVAL_SECONDS=300
SEND_FIRST_RUN=false
STATE_PATH=orders/seen_posts.json
ORDERS_PATH=orders

# AI-слой: off, draft или autopilot.
AUTO_MODE=autopilot
AUTO_MAX_PRICE_RUB=15000
AUTO_OUTREACH_ENABLED=false
AUTO_OUTREACH_MAX_AGE_HOURS=24
AUTO_QUALITY_ENABLED=true
AUTO_QUALITY_MAX_REPAIRS=2
AUTO_PAYMENT_REMINDER_ENABLED=true
EXECUTION_VERIFY_ENABLED=true
EXECUTION_RUNTIME=docker
EXECUTION_PYTHON_IMAGE=freelance-agent-python-runner:3.12-v1
EXECUTION_NODE_IMAGE=node:22-slim
EXECUTION_TIMEOUT_SECONDS=120
EXECUTION_MEMORY_MB=512
EXECUTION_CPUS=1.0
EXECUTION_MAX_OUTPUT_BYTES=65536
AGENT_QUEUE_ENABLED=true
AGENT_QUEUE_PATH=orders/agent_jobs.sqlite3
AGENT_JOBS_PER_CYCLE=3
AGENT_JOB_MAX_ATTEMPTS=4
AGENT_JOB_LEASE_SECONDS=600
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=put_openai_api_key_here

# Биржи и платежи. Заполняются после регистрации аккаунтов и получения API-доступов.
FREELANCEHUNT_API_TOKEN=
FREELANCEHUNT_API_SOURCE_ENABLED=true
FREELANCEHUNT_API_PAGES=1
FREELANCEHUNT_API_SKILL_IDS=180,169,22,86,178,189,150,197
FREELANCEHUNT_BID_SAFE_TYPE=employer
FREELANCEHUNT_BID_DAYS=2

# Автоотклик на явно опубликованный email заказчика. Без этих данных поиск продолжает работать.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Входящие email-ответы заказчиков. Нужны для автономной переписки после первого email-отклика.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=
FREELANCER_ACCESS_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Публичная выдача архива результата для площадок без загрузки вложений.
DELIVERY_PUBLIC_BASE_URL=
DELIVERY_PUBLIC_DIR=
DELIVERY_GATEWAY_ENABLED=false
DELIVERY_GATEWAY_HOST=127.0.0.1
DELIVERY_GATEWAY_PORT=8787
DELIVERY_TUNNEL_ENABLED=false
DELIVERY_PUBLIC_VERIFY_ENABLED=false
