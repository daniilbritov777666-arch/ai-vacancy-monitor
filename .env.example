TELEGRAM_BOT_TOKEN=put_telegram_bot_token_here
TELEGRAM_CHAT_ID=150761046

# Источники. По умолчанию используются RSS FL.ru и Freelancehunt, Telegram-каналы выключены.
TELEGRAM_CHANNELS=
RSS_FEEDS=https://www.fl.ru/rss/projects.xml,https://freelancehunt.com/projects.rss

# Локальный режим агента.
LOCAL_AGENT_LOOP=true
LOCAL_AGENT_INTERVAL_SECONDS=300
SEND_FIRST_RUN=false
STATE_PATH=orders/seen_posts.json
ORDERS_PATH=orders

# AI-слой: off, draft или autopilot.
AUTO_MODE=autopilot
AUTO_MAX_PRICE_RUB=15000
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=put_openai_api_key_here

# Биржи и платежи. Заполняются после регистрации аккаунтов и получения API-доступов.
FREELANCEHUNT_API_TOKEN=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_TENANT_ID=
FREELANCER_ACCESS_TOKEN=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
